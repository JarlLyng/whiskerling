        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flowers, sunglasses, top hat, scarf and crown, and for the room a cat tree, heart wallpaper, a picture of the cat and fairy lights. They still unlock with hearts."
          }
        }
      }
    },
